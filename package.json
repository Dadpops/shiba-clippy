{
  "name": "shiba-clippy",
  "version": "1.0.0",
  "description": "A cartoon Shiba Inu desktop assistant powered by Claude AI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --win --x64"
  },
  "author": "SolutionsKit LLC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.solutionskit.shiba-clippy",
    "productName": "Shiba Clippy",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
